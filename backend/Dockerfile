FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["ZapateriaJoselito.Api.csproj", "./"]
RUN dotnet restore "ZapateriaJoselito.Api.csproj"
COPY . .
RUN dotnet publish "ZapateriaJoselito.Api.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ZapateriaJoselito.Api.dll"]
